{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/products{catchall}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5001
        }
      ],
      "UpstreamPathTemplate": "/products{catchall}",
      "UpstreamHttpMethod": [ "GET", "POST" ],    
      "RateLimitOptions": {
        "EnableRateLimiting": true,
        "Limit": 2,
        "Period": "60s",
        "PeriodTimespan": 60
      }
    },
    {
      "DownstreamPathTemplate": "/api/orders{catchall}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5002
        }
      ],
      "UpstreamPathTemplate": "/orders{catchall}",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    },
    {
      "DownstreamPathTemplate": "/api/shipping{catchall}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 5003
        }
      ],
      "UpstreamPathTemplate": "/shipping{catchall}",
      "UpstreamHttpMethod": [ "GET", "POST" ]
    }
  ],
  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:5000"
  }
}